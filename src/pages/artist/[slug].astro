---
import Base from '../../layouts/Base.astro';
import SlotWidget from '../../components/SlotWidget.astro';
import ReserveForm from '../../components/ReserveForm.astro';
import { artists, rupiah } from '../../data/artists';

export const getStaticPaths = () => artists.map((a) => ({ params: { slug: a.slug }, props: { a } }));
const { a } = Astro.props;
---
<Base title={`${a.name} — RupaTinta`} description={`${a.name} (${a.city}): ${a.bio} Cek portofolio dan sisa slot komisi di RupaTinta.`}>
  <section class="ap" data-artist-slug={a.slug}>
    <div class="wrap">
      <a href="/#artist" class="back">← Semua artist</a>
      <div class="ap-head">
        <div class="who"><div class={`avatar lg ${a.avatar}`} data-pf="avatar"></div><div><h1 data-pf="name">{a.name}</h1><span data-pf="city">{a.city}</span></div></div>
        <div class="ap-meta">
          <span data-pf="cats" style="display:contents">{a.categories.map((c) => <span class="tag cat">{c}</span>)}</span>
          <span class="price">Mulai <b data-pf="price">{rupiah(a.priceFrom)}</b></span>
          <span class="tag" data-pf="slot" hidden></span>
        </div>
        <p class="bio" data-pf="bio">{a.bio}</p>
      </div>
      <div class="ap-grid">
        <div class="gallery" aria-label="Portofolio" data-artist={a.slug}>
          {a.gallery.map((g) => <div class={`tile ${g}`} data-seed={g}><div class="wm">PREVIEW</div></div>)}
        </div>
        <aside class="ap-side">
          <SlotWidget />
          <div class="card" data-closed hidden><h3 class="qt"></h3><p class="hint"></p></div>
          <ReserveForm artist={a} />
          <div data-queue></div>
        </aside>
      </div>
    </div>
  </section>
</Base>
<script>
import { artistBy, createOrder, esc, loadWorks, onProfileChange, onStoreChange, queueOf, queueRows, queueTable, remaining, workUrls } from '../../scripts/commissions';
import { normalizeWhatsapp } from '../../lib/phone';

const page = document.querySelector<HTMLElement>('.ap[data-artist-slug]')!, slug = page.dataset.artistSlug!;
const form = document.getElementById('pesan') as HTMLFormElement;
const $ = (s: string) => page.querySelector<HTMLElement>(s)!;

// Slots, the order form and the queue follow the artist's own slot settings and the orders saved in this browser.
function renderSide() {
  const a = artistBy(slug)!, filled = queueOf(a).length, { period, total } = a.slots;
  $('[data-sw-period]').textContent = period;
  $('[data-sw-slots]').innerHTML = Array.from({ length: total }, (_, i) => `<i${i < filled ? '' : ' class="free"'}></i>`).join('');
  $('[data-sw-meta]').innerHTML = total
    ? `Terisi <b>${Math.min(filled, total)}/${total}</b> · Sisa <b>${remaining(a, filled)}</b> slot`
    : 'Artist belum membuka slot untuk periode ini.';
  const closed = $('[data-closed]'), open = total > 0 && remaining(a, filled) > 0;
  closed.hidden = open;
  form.hidden = !open;
  closed.querySelector('h3')!.textContent = total ? `Slot ${period} sudah penuh` : 'Slot belum dibuka';
  closed.querySelector('p')!.textContent = total
    ? 'Semua slot periode ini sudah terisi. Kembali lagi saat artist membuka periode berikutnya.'
    : `${a.name} belum membuka slot komisi. Kamu tetap bisa melihat portofolionya dan kembali lagi nanti.`;
  $('[data-queue]').innerHTML = total || filled ? queueTable(queueRows(a)) : '';
}

function fieldError(name: string, text: string) {
  const input = form.elements.namedItem(name) as HTMLInputElement, err = document.getElementById(`e-${name}`)!;
  err.textContent = text; err.hidden = !text;
  input.setAttribute('aria-invalid', String(!!text));
  return !text;
}

form.addEventListener('submit', (e) => {
  e.preventDefault();
  const get = (k: string) => String(new FormData(form).get(k) ?? '').trim();
  const name = get('name'), brief = get('brief'), type = get('type'), wa = normalizeWhatsapp(get('whatsapp'));
  const ok = [
    fieldError('name', name.length < 2 ? 'Tulis namamu, minimal 2 huruf.' : ''),
    fieldError('whatsapp', !wa ? 'Masukkan nomor WhatsApp aktif, contoh 0812 3456 7890.' : ''),
    fieldError('brief', brief.length < 10 ? 'Ceritakan kebutuhanmu, minimal 10 karakter.' : ''),
  ].every(Boolean);
  const err = form.querySelector<HTMLElement>('.form-err')!;
  if (!ok || !wa) {
    err.textContent = 'Periksa lagi isian yang ditandai.'; err.hidden = false;
    return form.querySelector<HTMLElement>('[aria-invalid=true]')?.focus();
  }
  const a = artistBy(slug)!, r = createOrder(slug, { name, whatsapp: wa, type, brief });
  if (r.ok) return void (location.href = `/pesanan?kode=${r.code}&baru=1`);
  err.textContent = {
    closed: `${a.name} baru saja menutup slotnya, jadi pesananmu belum terkirim.`,
    full: `Slot ${a.slots.period} baru saja habis, jadi pesananmu belum terkirim.`,
    duplicate: `Nomor WhatsApp ini sudah punya pesanan aktif di ${a.name}. Cek statusnya di halaman Cek Pesanan.`,
    storage: 'Pesanan belum tersimpan. Penyimpanan browser mungkin penuh atau diblokir.',
  }[r.reason];
  err.hidden = false;
  renderSide();
});

// Works the illustrator uploaded from their dashboard (kept in this browser) appear before the existing gallery.
const gallery = document.querySelector<HTMLElement>('.gallery[data-artist]');
if (gallery) {
  const works = loadWorks(gallery.dataset.artist!);
  workUrls(works).then((urls) => {
    gallery.insertAdjacentHTML('afterbegin', works.filter((w) => urls.get(w.id))
      .map((w) => `<div class="tile"><img src="${urls.get(w.id)}" alt="${esc(w.name)}" /><div class="wm">PREVIEW</div></div>`).join(''));
  });
}

onStoreChange(renderSide);
onProfileChange(renderSide);
renderSide();
</script>
