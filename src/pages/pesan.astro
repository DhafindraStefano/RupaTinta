---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
---
<Base title="Pesan komisi — RupaTinta" description="Pilih ilustrator RupaTinta, amankan slot dengan kode pesanan, dan klaim karyamu setelah deal selesai.">
  <section class="studio" id="pesan-list">
    <div class="wrap">
      <div class="pf-head">
        <div>
          <Eyebrow>Pesan Sekarang</Eyebrow>
          <h1 class="page-h">Pilih ilustrator</h1>
          <p class="pf-note">Isi pesanan di halaman artist untuk mengamankan slot. Brief, harga, dan pembayaran disepakati langsung dengan artist di WhatsApp; karyamu bisa diklaim setelah deal selesai.</p>
        </div>
        <ol class="od-steps">
          <li><b>1</b>Pesan slot</li>
          <li><b>2</b>Deal di WhatsApp</li>
          <li><b>3</b>Klaim di Cek Pesanan</li>
        </ol>
      </div>
      <div class="od-artists" data-artists></div>
      <p class="q-empty" data-empty>Memuat ilustrator…</p>
    </div>
  </section>
</Base>
<script>
import { orderCard, watchArtists } from '../scripts/commissions';

const grid = document.querySelector<HTMLElement>('#pesan-list [data-artists]')!, empty = document.querySelector<HTMLElement>('#pesan-list [data-empty]')!;
watchArtists((list) => {
  grid.innerHTML = list.map(orderCard).join('');
  empty.hidden = list.length > 0;
  empty.textContent = 'Belum ada ilustrator yang bergabung. Kembali lagi nanti.';
}, () => { empty.textContent = 'Daftar ilustrator belum bisa dimuat. Periksa koneksi internet.'; });
</script>
