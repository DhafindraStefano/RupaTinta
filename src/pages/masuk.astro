---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
// Illustrator sign-in (Firebase Auth, email + password).
---
<Base title="Masuk — RupaTinta" noindex>
  <section class="narrow">
    <div class="wrap">
      <div class="login-wrap">
        <Eyebrow>Untuk ilustrator</Eyebrow>
        <h1 class="page-h">Masuk ke RupaTinta</h1>
        <p class="lede">Kelola slot, antrian pesanan, dan portofoliomu dari satu dasbor.</p>
        <form class="card rform" id="login" novalidate>
          <p class="form-err" role="alert" hidden></p>
          <label for="login-email">Email</label>
          <input id="login-email" name="email" type="email" required maxlength="80" autocomplete="username" spellcheck="false" />
          <label for="login-pw">Password</label>
          <input id="login-pw" name="password" type="password" required maxlength="80" autocomplete="current-password" />
          <button type="submit" class="btn btn-pri btn-block">Masuk</button>
        </form>
        <p class="hint login-foot">Belum punya akun ilustrator? <a href="/daftar">Daftar gratis →</a></p>
        <p class="hint login-foot">Mau memesan komisi? Pemesan tidak perlu akun. <a href="/pesan">Pilih ilustrator →</a></p>
      </div>
    </div>
  </section>
</Base>
<script>
import { authMessage, signIn, watchMe } from '../scripts/commissions';

const form = document.getElementById('login') as HTMLFormElement;
const err = form.querySelector<HTMLElement>('.form-err')!, btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
const email = form.elements.namedItem('email') as HTMLInputElement, pw = form.elements.namedItem('password') as HTMLInputElement;
let busy = false;

watchMe((me) => { if (me) location.replace('/ilustrator'); }); // already signed in, or just signed in

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (busy) return;
  const fail = (text: string) => { err.textContent = text; err.hidden = false; };
  if (!email.value.trim() || !pw.value) return fail('Isi email dan password.');
  busy = true; btn.disabled = true; btn.textContent = 'Masuk…';
  try {
    await signIn(email.value, pw.value);
  } catch (e) {
    fail(authMessage(e));
    pw.value = ''; pw.focus();
    busy = false; btn.disabled = false; btn.textContent = 'Masuk';
  }
});
</script>
