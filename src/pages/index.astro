---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ArtistGrid from '../components/ArtistGrid.astro';
import Faq from '../components/Faq.astro';
import About from '../components/About.astro';
import { artists } from '../data/artists';
import { filledCounts } from '../lib/reservations';

export const prerender = false;

// Live slot counts; if the database is unreachable the grid still renders, just without slot badges.
const counts = await filledCounts(artists).catch((e) => { console.error('filledCounts failed', e); return null; });
Astro.response.headers.set('Cache-Control', 'public, s-maxage=5, stale-while-revalidate=30');
---
<Base>
  <Hero />
  <ArtistGrid counts={counts} />
  <Faq />
  <About />
</Base>
