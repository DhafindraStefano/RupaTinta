---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Gate from '../components/Gate.astro';
import { MAX_CATEGORIES } from '../data/categories';
// Illustrator dashboard, laid out like a profile: header, slots + order queue, then the portfolio grid further down.
// Static shell; the account, profile, orders and works come live from Firebase (src/scripts/commissions.ts).
const STATS = [['filled', 'Slot terisi'], ['Menunggu', 'Menunggu'], ['Dikerjakan', 'Dikerjakan'], ['Selesai', 'Selesai']];
---
<Base title="Dasbor ilustrator — RupaTinta" noindex>
  <section class="studio" id="studio">
    <div class="wrap">
      <p class="q-empty studio-loading" data-loading>Memuat dasbor…</p>
      <Gate view="guest" eyebrow="Dasbor ilustrator" title="Masuk sebagai ilustrator" cta="Masuk" href="/masuk"
        text="Atur slot, kelola antrian pesanan, unggah karya, dan buka karyanya setelah deal selesai." />

      <div data-view="artist" hidden>
        <div class="card setup" data-setup hidden>
          <b>Lengkapi profilmu supaya tampil di RupaTinta.</b>
          <span>Masih kurang: <span data-missing></span>.</span>
          <button type="button" class="btn btn-pri btn-sm" data-edit-profile>Lengkapi profil</button>
        </div>

        <header class="prof">
          <div class="avatar prof-av" data-avatar></div>
          <div class="prof-body">
            <Eyebrow>Dasbor ilustrator</Eyebrow>
            <h1 data-name></h1>
            <p class="prof-sub"><span data-email></span><span data-city-wrap> · <span data-city></span></span></p>
            <ul class="prof-stats">
              <li><b data-count="works">0</b> karya</li>
              <li><b data-count="orders">0</b> pesanan</li>
              <li><b data-count="claimed">0</b> diklaim</li>
            </ul>
            <p class="prof-bio" data-bio></p>
            <div class="prof-actions">
              <label class="btn btn-pri od-file">+ Unggah karya<input type="file" multiple data-add-work aria-label="Unggah karya ke portofolio" /></label>
              <button type="button" class="btn btn-quiet" data-edit-profile>Edit profil</button>
            </div>
          </div>
        </header>

        <div class="card studio-orders">
          <h2 class="studio-h">Slot &amp; antrian</h2>
          <form class="slot-form" data-slot-form novalidate>
            <div><label for="sl-period">Periode</label><input id="sl-period" name="period" required maxlength="30" placeholder="Oktober" autocomplete="off" /></div>
            <div><label for="sl-total">Jumlah slot</label><input id="sl-total" name="total" type="number" inputmode="numeric" min="0" max="50" step="1" required /></div>
            <button type="submit" class="btn btn-quiet">Simpan slot</button>
          </form>
          <p class="hint">Isi 0 untuk menutup pesanan. Ganti periode untuk membuka antrian baru; pesanan yang dibatalkan melepas slotnya.</p>
          <div class="studio-stats">
            {STATS.map(([key, label]) => <div class="stat"><b data-stat={key}>0</b><span>{label}</span></div>)}
          </div>
          <p class="hint">Bahas brief dan harga dengan pemesan di WhatsApp. Unggah file asli (JPG, PNG, atau SVG) tanpa kompresi; pemesan bisa mengklaimnya lewat Cek Pesanan setelah status kamu ubah ke Selesai.</p>
          <div class="orders" data-list></div>
        </div>

        <div class="prof-grid-head">
          <h2 class="studio-h">Portofolio</h2>
          <span class="hint">JPG, PNG, atau SVG · disimpan tanpa kompresi · tampil di halaman artist-mu</span>
        </div>
        <div class="gallery prof-grid" data-works></div>
      </div>
      <p class="od-msg toast" role="status" hidden></p>

      <dialog class="dlg dlg-wide" id="profile-dlg" aria-labelledby="profile-h">
        <form class="rform" novalidate>
          <button type="button" class="dlg-x" data-close aria-label="Tutup">×</button>
          <h3 id="profile-h">Edit profil</h3>
          <p class="hint">Kolom bertanda <span class="req">*</span> wajib diisi. Profil tampil di RupaTinta setelah tersimpan.</p>
          <div class="pe-photo">
            <div class="avatar pe-av" data-pe-avatar></div>
            <div class="pe-photo-act">
              <label class="btn btn-quiet od-file">Ganti foto<input type="file" name="photo" aria-label="Pilih foto profil" /></label>
              <button type="button" class="od-link" data-pe-reset-photo>Hapus foto</button>
              <span class="pe-note">JPG, PNG, atau SVG</span>
            </div>
          </div>
          <label for="pe-name">Nama <span class="req">*</span></label>
          <input id="pe-name" name="name" required maxlength="60" autocomplete="off" />
          <label for="pe-city">Kota <span class="req">*</span></label>
          <input id="pe-city" name="city" required maxlength="40" autocomplete="off" />
          <label for="pe-bio">Deskripsi</label>
          <textarea id="pe-bio" name="bio" rows="3" maxlength="300" placeholder="Gaya, spesialisasi, dan jenis komisi yang kamu terima."></textarea>
          <fieldset class="od-role pe-cats">
            <legend>Kategori</legend>
            <div data-cat-list></div>
            <p class="hint" id="pe-cat-hint">Pilih sampai {MAX_CATEGORIES}. Kategori juga jadi pilihan jenis komisi di formulir pesanan.</p>
          </fieldset>
          <div class="pe-row">
            <div><label for="pe-price">Harga mulai (Rp) <span class="req">*</span></label><input id="pe-price" name="priceFrom" type="number" inputmode="numeric" min="10000" step="1000" required /></div>
            <div><label for="pe-wa">Nomor WhatsApp <span class="req">*</span></label><input id="pe-wa" name="whatsapp" type="tel" inputmode="tel" maxlength="20" required placeholder="0812 3456 7890" aria-describedby="pe-wa-err" /><p class="field-err" id="pe-wa-err" hidden></p></div>
          </div>
          <p class="form-err" role="alert" hidden></p>
          <div class="dlg-actions">
            <button type="button" class="btn btn-quiet" data-close>Batal</button>
            <button type="submit" class="btn btn-pri">Simpan</button>
          </div>
        </form>
      </dialog>

      <dialog class="dlg" id="cat-dlg" aria-labelledby="cat-h">
        <form class="rform" novalidate>
          <button type="button" class="dlg-x" data-close aria-label="Tutup">×</button>
          <h3 id="cat-h">Tambah kategori</h3>
          <p class="hint">Kategori baru tersimpan untuk semua ilustrator dan langsung dipilih di profilmu.</p>
          <label for="cat-name">Nama kategori</label>
          <input id="cat-name" name="name" required minlength="2" maxlength="30" autocomplete="off" placeholder="mis. Pixel Art" aria-describedby="cat-err" />
          <p class="field-err" id="cat-err" role="alert" hidden></p>
          <div class="dlg-actions">
            <button type="button" class="btn btn-quiet" data-close>Batal</button>
            <button type="submit" class="btn btn-pri">Tambah</button>
          </div>
        </form>
      </dialog>
    </div>
  </section>
</Base>
<script>
import {
  addWork, addCategory, ART_ACCEPT, day, PhotoError, uploadMessage, validCategory, watchCategories, deleteWork, esc, fileSize, flasher, isAllowedArt, missing, orderArtUrl, paintAvatar, saveProfile,
  saveSlots, setStatus, stateOf, STATUSES, syncCovers, uploadOrderArt, waCustomer, watchArtistOrders, watchMe, watchWorks,
  type Me, type Order, type Status, type Work,
} from '../scripts/commissions';
import { normalizeWhatsapp } from '../lib/phone';
import { MAX_CATEGORIES, type Category } from '../data/categories';
import { closeDialog, confirmDialog, openDialog, wireDialog } from '../scripts/ui';

const root = document.getElementById('studio')!;
const $ = <T extends HTMLElement = HTMLElement>(s: string) => root.querySelector<T>(s)!;
const say = flasher($('.od-msg'));
const errMsg = 'Belum tersimpan. Periksa koneksi internet lalu coba lagi.';
let me: Me | null = null, orders: Order[] = [], works: Work[] = [], urls = new Map<string, string | null>(), pass = 0;
let stopOrders: (() => void) | undefined, stopWorks: (() => void) | undefined, uid = '';
const fresh = new Set<string>(); // works just added, to fade in
root.querySelectorAll<HTMLInputElement>('[data-add-work]').forEach((i) => { i.accept = ART_ACCEPT; });
const artist = () => me?.artist ?? null;

function showView(view: 'guest' | 'artist' | null) {
  $('[data-loading]').hidden = view !== null;
  root.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => { v.hidden = v.dataset.view !== view; });
}

watchMe((next) => {
  me = next;
  if (!me) { stopOrders?.(); stopWorks?.(); uid = ''; return showView('guest'); }
  if (!me.artist) return; // profile doc still being created (sign-up)
  if (uid !== me.uid) {
    uid = me.uid;
    stopOrders?.(); stopWorks?.();
    stopOrders = watchArtistOrders(uid, (list) => { orders = list; renderOrders(); });
    stopWorks = watchWorks(uid, (list) => { works = list; renderWorks(); if (artist()) syncCovers(artist()!, works); });
  }
  showView('artist');
  renderProfile();
  renderOrders();
});

function renderProfile() {
  const a = artist()!;
  paintAvatar($('[data-avatar]'), a);
  $('[data-name]').textContent = a.name;
  $('[data-email]').textContent = me!.email;
  $('[data-city]').textContent = a.city;
  $('[data-city-wrap]').hidden = !a.city;
  $('[data-bio]').textContent = a.bio;
  const gaps = missing(a);
  $('[data-setup]').hidden = !gaps.length;
  $('[data-missing]').textContent = gaps.join(', ');
  const form = $<HTMLFormElement>('[data-slot-form]');
  if (!form.contains(document.activeElement)) { // don't overwrite what the artist is typing
    (form.elements.namedItem('period') as HTMLInputElement).value = a.slots.period;
    (form.elements.namedItem('total') as HTMLInputElement).value = String(a.slots.total);
  }
}

function item(o: Order, position: number | null) {
  const a = artist()!, st = stateOf(o);
  const label = position ? `#${position} · ${esc(o.name)}` : esc(o.name);
  const where = position ? '' : o.status === 'Dibatalkan' ? ' · slot dilepas' : ` · periode ${esc(o.period)}`;
  const note = o.claimed ? 'Pemesan sudah mengklaim karya ini.'
    : st.key === 'ready' ? 'Karya sudah terbuka untuk pemesan.'
    : o.art ? 'Karya tersimpan dan masih terkunci. Ubah status ke Selesai setelah pembayaran diterima.'
    : o.status === 'Dibatalkan' ? 'Pesanan dibatalkan.'
    : 'Sepakati brief dan harga di WhatsApp, lalu unggah karyanya di sini.';
  const file = o.art ? `${esc(o.art.name)} · ${fileSize(o.art.size)}` : 'Belum ada file';
  const url = urls.get(o.code);
  const thumb = url ? `<div class="od-thumb"><img src="${esc(url)}" alt="" /></div>` : '<div class="od-thumb"></div>';
  const upload = o.claimed || o.status === 'Dibatalkan' ? ''
    : `<label class="btn btn-quiet od-file">${o.art ? 'Ganti file' : 'Unggah file asli'}<input type="file" accept="${ART_ACCEPT}" data-upload="${o.code}" /></label>`;
  return `<article class="card order st-${o.status.toLowerCase()}">
    <div class="o-head"><div><b>${label}</b><span>${o.code} · ${esc(o.type)}${where}</span></div><time>${day(o.at)}</time></div>
    <p class="o-brief">${esc(o.brief)}</p>
    <div class="o-art">${thumb}
      <div class="od-info"><div class="od-line"><b>${file}</b><span class="tag ${st.cls}">${st.label}</span></div><p>${note}</p></div>
      <div class="od-act">${upload}</div></div>
    <div class="o-foot">
      <a class="btn btn-wa" href="${waCustomer(a, o)}" target="_blank" rel="noopener">WhatsApp +${o.whatsapp}</a>
      <div class="o-status"><label class="sr" for="s-${o.code}">Status</label>
        <select id="s-${o.code}" data-status="${o.code}"${o.claimed ? ' disabled' : ''}>${STATUSES.map((s) => `<option${s === o.status ? ' selected' : ''}>${s}</option>`).join('')}</select></div>
    </div></article>`;
}

async function renderOrders() {
  const a = artist();
  if (!a) return;
  // Queue for the current period first (oldest first, numbered), then everything else, newest first.
  const queue = orders.filter((o) => o.period === a.slots.period && o.status !== 'Dibatalkan').sort((x, y) => x.at - y.at);
  const rest = orders.filter((o) => !queue.includes(o)).sort((x, y) => y.at - x.at);
  const all = [...queue, ...rest], live = all.filter((o) => o.status !== 'Dibatalkan');
  $('[data-count="orders"]').textContent = String(live.length);
  $('[data-count="claimed"]').textContent = String(all.filter((o) => o.claimed).length);
  root.querySelectorAll<HTMLElement>('[data-stat]').forEach((el) => {
    el.textContent = el.dataset.stat === 'filled' ? `${queue.length}/${a.slots.total}` : String(live.filter((o) => o.status === el.dataset.stat).length);
  });
  const my = ++pass;
  const next = new Map(await Promise.all(all.map(async (o) => [o.code, await orderArtUrl(o)] as const)));
  if (my !== pass) return; // a newer render started while URLs were loading
  urls = next;
  $('[data-list]').innerHTML = all.length ? all.map((o) => item(o, queue.includes(o) ? queue.indexOf(o) + 1 : null)).join('')
    : `<p class="q-empty">${!a.listed ? 'Lengkapi profil dan buka slot supaya pemesan bisa memesan.'
      : a.slots.total ? 'Belum ada pesanan. Pesanan dari halaman artist-mu akan muncul di sini.'
      : 'Slot masih tutup. Isi jumlah slot di atas supaya pemesan bisa memesan.'}</p>`;
}

/** Portfolio grid: an add tile, then the artist's works (newest first). */
function renderWorks() {
  $('[data-count="works"]').textContent = String(works.length);
  $('[data-works]').innerHTML = [
    `<label class="tile tile-add"><span aria-hidden="true">+</span>Tambah karya<input type="file" multiple accept="${ART_ACCEPT}" data-add-work /></label>`,
    ...works.map((w) => `<figure class="tile${fresh.has(w.id) ? ' tile-new' : ''}"><img src="${esc(w.url)}" alt="${esc(w.name)}" loading="lazy" />
      <button type="button" class="tile-del" data-del="${w.id}" aria-label="Hapus ${esc(w.name)}">×</button></figure>`),
  ].join('');
  fresh.clear();
}

async function addWorks(input: HTMLInputElement) {
  const picked = [...(input.files ?? [])];
  input.value = '';
  if (!picked.length || !me) return;
  const ok = picked.filter(isAllowedArt);
  let added = 0, lastErr: unknown;
  for (const [i, f] of ok.entries()) {
    say(`Mengunggah karya ${i + 1} dari ${ok.length}…`, true);
    try { fresh.add((await addWork(me.uid, f)).id); added++; } catch (e) { console.error(e); lastErr = e; }
  }
  const skipped = picked.length - ok.length, failed = ok.length - added;
  if (added) {
    say(`${added} karya ditambahkan ke portofolio tanpa kompresi.${skipped ? ` ${skipped} file dilewati karena bukan JPG, PNG, atau SVG.` : ''}${failed ? ` ${failed} gagal diunggah.` : ''}`);
    $('[data-works]').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  } else say(skipped && !failed ? 'Format tidak didukung. Unggah file JPG, PNG, atau SVG.' : uploadMessage(lastErr));
}

root.addEventListener('click', async (e) => {
  const t = e.target as Element;
  const del = t.closest<HTMLElement>('[data-del]');
  if (del && me) {
    const w = works.find((x) => x.id === del.dataset.del);
    const ok = w && await confirmDialog({ title: 'Hapus karya ini?', text: 'Karya akan hilang dari portofolio dan halaman artist-mu.', confirm: 'Hapus' });
    if (!ok) return;
    try { await deleteWork(me.uid, w); say('Karya dihapus dari portofolio.'); } catch { say(errMsg); }
    return;
  }
  if (t.closest('[data-edit-profile]')) return openEditor();
});

$<HTMLFormElement>('[data-slot-form]').addEventListener('submit', async (e) => {
  e.preventDefault();
  const a = artist();
  if (!a) return;
  const f = e.currentTarget as HTMLFormElement;
  const period = (f.elements.namedItem('period') as HTMLInputElement).value.trim();
  const total = Number((f.elements.namedItem('total') as HTMLInputElement).value);
  if (period.length < 2) return say('Tulis nama periodenya, misalnya "Oktober".');
  if (!Number.isInteger(total) || total < 0 || total > 50) return say('Jumlah slot harus angka 0 sampai 50.');
  try { await saveSlots(a, period, total, orders); } catch { return say(errMsg); }
  (document.activeElement as HTMLElement | null)?.blur();
  say(!total ? 'Slot ditutup. Pemesan belum bisa memesan sampai kamu membukanya lagi.'
    : a.listed ? `Slot ${period} dibuka: ${total} slot.` : `Slot ${period} disimpan. Lengkapi profil supaya pemesan bisa memesan.`);
});

// Files are stored exactly as uploaded, with no resizing or re-encoding.
root.addEventListener('change', async (e) => {
  const t = e.target as HTMLInputElement;
  if (t.matches('[data-add-work]')) return addWorks(t);
  const a = artist();
  if (!a) return;
  const sel = t.closest<HTMLSelectElement>('[data-status]');
  if (sel) {
    const o = orders.find((x) => x.code === sel.dataset.status);
    if (!o || o.claimed) return;
    const status = sel.value as Status;
    try { await setStatus(a, o, status, orders); } catch { sel.value = o.status; return say(errMsg); }
    return say(status === 'Selesai' ? (o.art ? 'Selesai. Pemesan sekarang bisa mengklaim karyanya.' : 'Selesai. Unggah karyanya agar pemesan bisa mengklaim.')
      : status === 'Dibatalkan' ? 'Pesanan dibatalkan dan slotnya dilepas.'
      : `Status ${o.code} diubah ke ${status}.`);
  }
  const input = t.closest<HTMLInputElement>('[data-upload]');
  const file = input?.files?.[0];
  const o = input && orders.find((x) => x.code === input.dataset.upload);
  if (!file || !o) return;
  if (!isAllowedArt(file)) { input.value = ''; return say('Format tidak didukung. Unggah file JPG, PNG, atau SVG.'); }
  say(`Mengunggah ${file.name}…`, true);
  try {
    await uploadOrderArt(o, file);
    say(`${file.name} (${fileSize(file.size)}) tersimpan tanpa kompresi.${o.status === 'Selesai' ? ' Pemesan sudah bisa mengklaimnya.' : ' Pemesan bisa mengklaimnya setelah status Selesai.'}`);
  } catch (err) {
    console.error(err);
    input.value = '';
    say(uploadMessage(err));
  }
});

// ---- edit profile ----
const pdlg = document.getElementById('profile-dlg') as HTMLDialogElement, pform = pdlg.querySelector('form')!;
const field = (n: string) => pform.elements.namedItem(n) as HTMLInputElement;
const perr = pform.querySelector<HTMLElement>('.form-err')!, peAvatar = pform.querySelector<HTMLElement>('[data-pe-avatar]')!;
const saveBtn = pform.querySelector<HTMLButtonElement>('button[type=submit]')!;
let photo: File | null | undefined; // chosen in the editor but not saved yet: File = new photo, null = remove photo
let preview: string | null = null;
let allCats: Category[] = [];
field('photo').accept = ART_ACCEPT;
wireDialog(pdlg);
const catList = pform.querySelector<HTMLElement>('[data-cat-list]')!, waErr = pform.querySelector<HTMLElement>('#pe-wa-err')!;
const checkedCats = () => [...pform.querySelectorAll<HTMLInputElement>('[name=categories]:checked')].map((c) => c.value);

/** Category chips: the shared list plus any the artist already has; keeps what is ticked. */
function renderCats(checked = checkedCats()) {
  const names = [...allCats, ...checked.filter((c) => !allCats.includes(c))];
  catList.innerHTML = names.map((c) => `<label><input type="checkbox" name="categories" value="${esc(c)}"${checked.includes(c) ? ' checked' : ''} /><span>${esc(c)}</span></label>`).join('')
    + '<button type="button" class="chip-add" data-open-cat>+ Tambah kategori</button>';
}
watchCategories((list) => { allCats = list; renderCats(); });

// Adding a category happens in its own small dialog on top of the profile editor.
const cdlg = document.getElementById('cat-dlg') as HTMLDialogElement, cform = cdlg.querySelector('form')!;
const cinput = cform.elements.namedItem('name') as HTMLInputElement, cerr = cform.querySelector<HTMLElement>('#cat-err')!;
const cbtn = cform.querySelector<HTMLButtonElement>('button[type=submit]')!;
wireDialog(cdlg);

function openCatDialog() {
  cform.reset(); cerr.hidden = true; cinput.removeAttribute('aria-invalid');
  openDialog(cdlg);
  cinput.focus();
}

cform.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (cbtn.disabled) return;
  const name = cinput.value.trim(), checked = checkedCats();
  const fail = (t: string) => { cerr.textContent = t; cerr.hidden = false; cinput.setAttribute('aria-invalid', 'true'); cinput.focus(); };
  if (!name) return fail('Tulis nama kategorinya dulu.');
  if (!validCategory(name)) return fail('Nama kategori 2 sampai 30 karakter.');
  if (checked.length >= MAX_CATEGORIES) return fail(`Kamu sudah memilih ${MAX_CATEGORIES} kategori. Hapus centang salah satu dulu.`);
  cbtn.disabled = true; cbtn.textContent = 'Menyimpan…';
  try {
    const saved = await addCategory(name, allCats);
    if (!allCats.includes(saved)) allCats = [...allCats, saved];
    renderCats([...new Set([...checked, saved])]);
    closeDialog(cdlg);
  } catch (err) {
    console.error(err);
    fail('Kategori belum tersimpan. Periksa koneksi internet lalu coba lagi.');
  } finally { cbtn.disabled = false; cbtn.textContent = 'Tambah'; }
});
pform.addEventListener('click', (e) => { if ((e.target as Element).closest('[data-open-cat]')) openCatDialog(); });

function openEditor() {
  const a = artist();
  if (!a) return;
  pform.reset();
  photo = undefined; perr.hidden = true; waErr.hidden = true; field('whatsapp').removeAttribute('aria-invalid');
  field('name').value = a.name; field('city').value = a.city; field('priceFrom').value = a.priceFrom ? String(a.priceFrom) : '';
  field('whatsapp').value = a.whatsapp ? '0' + a.whatsapp.slice(2) : '';
  (pform.elements.namedItem('bio') as HTMLTextAreaElement).value = a.bio;
  renderCats(a.categories);
  paintAvatar(peAvatar, a);
  openDialog(pdlg);
}

pform.addEventListener('change', (e) => {
  const input = e.target as HTMLInputElement, a = artist();
  if (input.name !== 'photo' || !input.files?.[0] || !a) return;
  const f = input.files[0];
  if (!isAllowedArt(f)) { input.value = ''; perr.textContent = 'Foto harus berupa file JPG, PNG, atau SVG.'; perr.hidden = false; return; }
  perr.hidden = true;
  photo = f;
  if (preview) URL.revokeObjectURL(preview);
  preview = URL.createObjectURL(f);
  paintAvatar(peAvatar, { name: field('name').value || a.name, photo: null }, preview);
});
pform.querySelector('[data-pe-reset-photo]')!.addEventListener('click', () => {
  const a = artist();
  if (!a) return;
  photo = null; field('photo').value = '';
  paintAvatar(peAvatar, { name: field('name').value || a.name, photo: null }, null);
});

pform.addEventListener('submit', async (e) => {
  e.preventDefault();
  const a = artist();
  if (!a || saveBtn.disabled) return;
  const name = field('name').value.trim(), city = field('city').value.trim();
  const bio = (pform.elements.namedItem('bio') as HTMLTextAreaElement).value.trim();
  const categories = checkedCats();
  const priceFrom = Math.round(Number(field('priceFrom').value));
  const waInput = field('whatsapp'), whatsapp = normalizeWhatsapp(waInput.value);
  // WhatsApp is how customers reach the artist, so it gets its own message next to the field.
  waErr.textContent = !waInput.value.trim() ? 'Nomor WhatsApp wajib diisi.' : !whatsapp ? 'Nomor WhatsApp tidak valid, contoh 0812 3456 7890.' : '';
  waErr.hidden = !waErr.textContent;
  waInput.setAttribute('aria-invalid', String(!whatsapp));
  const problem = name.length < 2 ? 'Tulis nama, minimal 2 huruf.'
    : city.length < 2 ? 'Tulis kotamu.'
    : !categories.length ? 'Pilih minimal satu kategori.'
    : categories.length > MAX_CATEGORIES ? `Maksimal ${MAX_CATEGORIES} kategori.`
    : !(priceFrom >= 10000) ? 'Harga mulai minimal Rp10.000.'
    : !whatsapp ? 'Lengkapi nomor WhatsApp dulu.'
    : '';
  perr.textContent = problem; perr.hidden = !problem;
  if (!whatsapp) waInput.focus();
  if (problem || !whatsapp) return;
  saveBtn.disabled = true; saveBtn.textContent = photo ? 'Mengunggah foto…' : 'Menyimpan…';
  try {
    await saveProfile(a, { name, city, bio, categories, priceFrom, whatsapp }, photo);
    closeDialog(pdlg);
    say(a.listed ? 'Profil diperbarui.' : 'Profil lengkap. Kamu sekarang tampil di RupaTinta; buka slot supaya pemesan bisa memesan.');
  } catch (err) {
    console.error(err);
    if (err instanceof PhotoError) { photo = undefined; field('photo').value = ''; }
    perr.textContent = err instanceof PhotoError
      ? 'Profil tersimpan, tapi foto gagal diunggah. Periksa koneksi internet, atau penyimpanan file Firebase belum aktif.'
      : 'Profil belum tersimpan. Periksa koneksi internet lalu coba lagi.';
    perr.hidden = false;
  } finally {
    saveBtn.disabled = false; saveBtn.textContent = 'Simpan';
  }
});
</script>
