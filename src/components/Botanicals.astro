---
// Shared botanical motifs (original drawings in the spirit of chinoiserie wallpaper).
// Referenced elsewhere with <use href="#id" />; `color` on the <use> sets the petal colour.
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <g id="leaf">
      <path d="M0 0C-7.5-6-6.5-18 0-25C6.5-18 7.5-6 0 0Z" fill="#8f8c5c" />
      <path d="M0-2C.6-9 .6-16 0-22" stroke="#5c5a37" stroke-width=".9" fill="none" stroke-linecap="round" />
      <path d="M0 0C-7.5-6-6.5-18 0-25" stroke="#5c5a37" stroke-width=".7" fill="none" opacity=".5" />
    </g>
    <g id="leaf2">
      <path d="M0 0C-7.5-6-6.5-18 0-25C6.5-18 7.5-6 0 0Z" fill="#6C6A43" />
      <path d="M0-2C.6-9 .6-16 0-22" stroke="#b9b68a" stroke-width=".9" fill="none" stroke-linecap="round" />
    </g>
    <g id="blossom">
      <g fill="currentColor" stroke="#4D3449" stroke-width=".6" stroke-opacity=".35">
        <ellipse cy="-6.5" rx="5" ry="6.6" />
        <ellipse cy="-6.5" rx="5" ry="6.6" transform="rotate(72)" />
        <ellipse cy="-6.5" rx="5" ry="6.6" transform="rotate(144)" />
        <ellipse cy="-6.5" rx="5" ry="6.6" transform="rotate(216)" />
        <ellipse cy="-6.5" rx="5" ry="6.6" transform="rotate(288)" />
      </g>
      <circle r="3.6" fill="#FFF0D2" />
      <g fill="#4D3449"><circle cx="0" cy="-1.6" r=".7" /><circle cx="1.5" cy=".6" r=".7" /><circle cx="-1.5" cy=".6" r=".7" /></g>
    </g>
    <g id="peony">
      <g fill="currentColor" stroke="#4D3449" stroke-width=".7" stroke-opacity=".35">
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(45) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(90) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(135) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(180) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(225) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(270) scale(1.45)" />
        <path d="M0-3C-9-9-8-21 0-19C8-21 9-9 0-3Z" transform="rotate(315) scale(1.45)" />
      </g>
      <g fill="#f6c9dc" opacity=".9">
        <ellipse cy="-6" rx="5.5" ry="7" transform="rotate(22)" />
        <ellipse cy="-6" rx="5.5" ry="7" transform="rotate(112)" />
        <ellipse cy="-6" rx="5.5" ry="7" transform="rotate(202)" />
        <ellipse cy="-6" rx="5.5" ry="7" transform="rotate(292)" />
      </g>
      <circle r="5" fill="#FFF0D2" />
      <circle r="2.4" fill="#BF3556" />
    </g>
    <g id="bud">
      <path d="M0 0C-3.6-3-3.6-9 0-12C3.6-9 3.6-3 0 0Z" fill="currentColor" />
      <path d="M-3 0C-1.5-4.5 1.5-4.5 3 0Z" fill="#6C6A43" />
    </g>
  </defs>
</svg>
