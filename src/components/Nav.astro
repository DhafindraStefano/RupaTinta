---
import LogoMark from './LogoMark.astro';
// Only illustrators sign in (/masuk); the session is kept by src/scripts/commissions.ts.
---
<nav aria-label="Navigasi utama">
  <a href="/" class="logo" aria-label="RupaTinta, beranda"><LogoMark /><span>RupaTinta<small>Open Commission Design</small></span></a>
  <div class="links"><a href="/#artist">Cari Artist</a><a href="/pesan">Pesan Sekarang</a><a href="/pesanan">Cek Pesanan</a><a href="/#faq">FAQ</a></div>
  <div class="auth">
    <a href="/masuk" class="btn btn-pri btn-sm" data-login>Masuk</a>
    <div class="auth-user" hidden>
      <a href="/ilustrator" class="auth-who"><b></b><small></small></a>
      <button type="button" class="od-link" data-logout>Keluar</button>
    </div>
  </div>
</nav>
<script>
import { applyProfiles, artistBy, loadSession, onProfileChange, onStoreChange, saveSession } from '../scripts/commissions';

const loginBtn = document.querySelector<HTMLElement>('nav [data-login]')!, user = document.querySelector<HTMLElement>('.auth-user')!;
const who = document.querySelector<HTMLAnchorElement>('.auth-who')!;

function paint() {
  const s = loadSession();
  loginBtn.hidden = !!s;
  user.hidden = !s;
  if (!s) return;
  who.querySelector('b')!.textContent = artistBy(s.artist)!.name; // illustrators may have renamed themselves
  who.querySelector('small')!.textContent = 'Dasbor ilustrator';
}

document.querySelector('[data-logout]')!.addEventListener('click', () => saveSession(null));
onStoreChange(() => { paint(); applyProfiles(); });
onProfileChange(() => { paint(); applyProfiles(); });
paint();
applyProfiles(); // illustrators' own edits and live slot counts on cards and pages (kept in this browser)
</script>
