---
import { type Artist, rupiah } from '../data/artists';
// Slot badge and bar are filled in the browser from the artist's slot settings (applyProfiles in src/scripts/commissions.ts).
interface Props { artist: Artist }
const { artist: a } = Astro.props;
---
<a class="acard" href={`/artist/${a.slug}`} data-categories={a.categories.join('|')} data-artist-slug={a.slug}>
  <div class="cover" aria-hidden="true">{a.cover.map((c) => <div class={c}></div>)}</div>
  <div class="body">
    <div class="row">
      <div class="who"><div class={`avatar sm ${a.avatar}`} data-pf="avatar"></div><div><b data-pf="name">{a.name}</b><span data-pf="city">{a.city}</span></div></div>
      <span class="tag" data-pf="slot" hidden></span>
    </div>
    <div class="bar" data-pf="bar" hidden><i></i></div>
    <div class="price">Mulai <b data-pf="price">{rupiah(a.priceFrom)}</b> · {a.mainLabel}</div>
  </div>
</a>
