---
import type { QueueRow, Status } from '../lib/reservations';
interface Props { rows: QueueRow[]; highlight?: string; title?: string }
const { rows, highlight, title = 'Antrian saat ini' } = Astro.props;
const pill: Record<Status, string> = { Selesai: 'st-open', Dikerjakan: 'st-prog', Menunggu: 'st-few', Dibatalkan: 'st-full' };
---
<div class="card">
  <h3 class="qt">{title}</h3>
  {rows.length === 0
    ? <p class="q-empty">Belum ada antrian. Pesanan pertama langsung dapat nomor #1.</p>
    : (
      <div class="q" role="table" aria-label={title}>
        <div class="qh" role="row"><span role="columnheader">No</span><span role="columnheader">Klien</span><span role="columnheader">Jenis</span><span role="columnheader">Status</span></div>
        {rows.map((q) => (
          <div class={`qr${q.code === highlight ? ' me' : ''}`} role="row"><span role="cell">#{q.position}</span><span role="cell">{q.code === highlight ? 'Kamu' : q.client}</span><span role="cell">{q.type}</span><span role="cell"><span class={`prog ${pill[q.status]}`}>{q.status}</span></span></div>
        ))}
      </div>
    )}
</div>
