---
import Eyebrow from './Eyebrow.astro';
// Shown instead of a page's content when the visitor isn't signed in (toggled by showView).
interface Props { view: 'guest' | 'artist'; eyebrow: string; title: string; text: string; href: string; cta: string }
const { view, eyebrow, title, text, href, cta } = Astro.props;
---
<div class="card od-guest" data-view={view} hidden>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h1 class="page-h">{title}</h1>
  <p class="hint">{text}</p>
  <a class="btn btn-pri" href={href}>{cta}</a>
</div>
