---
// Filled (commission types) and submitted by the artist page's script, src/pages/artist/index.astro.
---
<form class="card rform" id="pesan" novalidate hidden>
  <h3>Pesan komisi</h3>
  <p class="hint">Slot langsung jadi milikmu begitu pesanan terkirim. Harga akhir dan pembayaran dibahas bersama artist lewat WhatsApp.</p>
  <p class="form-err" role="alert" hidden></p>
  <label for="f-name">Nama</label>
  <input id="f-name" name="name" required maxlength="60" autocomplete="name" aria-describedby="e-name" />
  <p class="field-err" id="e-name" hidden></p>
  <label for="f-wa">Nomor WhatsApp</label>
  <input id="f-wa" name="whatsapp" type="tel" inputmode="tel" required maxlength="20" autocomplete="tel" placeholder="0812 3456 7890" aria-describedby="e-whatsapp" />
  <p class="field-err" id="e-whatsapp" hidden></p>
  <label for="f-type">Jenis komisi</label>
  <select id="f-type" name="type" required></select>
  <label for="f-brief">Brief</label>
  <textarea id="f-brief" name="brief" required rows="5" maxlength="1500" placeholder="Ceritakan karakter, pose, referensi (link), pemakaian pribadi/komersial, dan deadline." aria-describedby="e-brief"></textarea>
  <p class="field-err" id="e-brief" hidden></p>
  <button type="submit" class="btn btn-pri btn-block">Kirim pesanan</button>
</form>
