---
import Eyebrow from './Eyebrow.astro';
const items = [
  ['Bagaimana cara kerja slot real-time?', 'Setiap ilustrator menentukan sendiri jumlah slot per periode. Saat pesananmu masuk, slot otomatis berkurang dan kamu langsung mendapat kode pesanan serta nomor antrian yang bisa dipantau di halaman Cek Pesanan.'],
  ['Apakah pembayaran aman?', 'Saat ini detail pembayaran disepakati langsung dengan artist setelah pesananmu diterima. Kami sedang menyiapkan pembayaran bertahap yang lebih aman melalui platform.'],
  ['Bolehkah karya dipakai untuk keperluan komersial?', 'Bisa, selama disepakati dengan artist saat memesan. Sampaikan kebutuhan pemakaianmu (pribadi atau komersial) di brief agar harganya jelas sejak awal.'],
  ['Bagaimana cara mengambil karyaku?', 'Setelah deal di WhatsApp selesai, artist mengunggah file aslinya dan menandai pesanan selesai. Buka Cek Pesanan, masukkan kode pesananmu, lalu klaim dan unduh karyanya tanpa kompresi.'],
  ['Bagaimana kalau hasil tidak sesuai brief?', 'Sepakati jumlah revisi dengan artist di WhatsApp sebelum mulai. File final baru bisa diklaim setelah artist menandai pesanan selesai, jadi revisi dibahas sebelum itu.'],
];
---
<section id="faq" style="padding-top:20px">
  <div class="wrap faq">
    <div><Eyebrow>FAQ</Eyebrow><h2 style="margin-top:14px">Pertanyaan yang sering muncul</h2><p class="sub">Masih ada yang bingung? Hubungi kami lewat media sosial RupaTinta.</p></div>
    <div>
      {items.map(([q, a], i) => (
        <details class="qa" open={i === 0}><summary>{q}</summary><p>{a}</p></details>
      ))}
    </div>
  </div>
</section>
